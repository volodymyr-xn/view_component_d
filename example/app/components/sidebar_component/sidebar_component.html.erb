<nav class="sidebar" aria-label="Primary" data-sidebar>
  <% if (hasBrand) { %>
  <div class="sidebar__brand"><%= brand %></div>
  <% } %>

  <% if (hasNotices) { %>
  <ul class="sidebar__notices">
    <% foreach (notice; notices) { %>
    <li class="sidebar__notice"><%= notice %></li>
    <% } %>
  </ul>
  <% } %>

  <% if (hasNavigation) { %>
  <div class="sidebar__sections">
    <% render(sections); %>
  </div>
  <% } else { %>
  <p class="sidebar__empty">No navigation available.</p>
  <% } %>

  <%# Constructed and rendered right here: no slot from the caller, but slots
      of its own, filled inline because every `withX` returns the component. %>
  <%= new SidebarStatusComponent(sectionCount, totalLinkCount, currentPath)
        .withHint(raw("<em>live</em>"))
        .withChips("nav")
        .withChips("beta & new") %>

  <% if (hasContent) { %>
  <div class="sidebar__extra"><%= content %></div>
  <% } %>

  <% if (hasFooter) { %>
  <% render(footer); %>
  <% } %>
</nav>
