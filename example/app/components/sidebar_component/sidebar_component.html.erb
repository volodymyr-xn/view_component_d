<nav class="sidebar" aria-label="Primary" data-sidebar>
  <%- if (hasBrand) { -%>
  <div class="sidebar__brand"><%= brand %></div>
  <%- } -%>

  <%- if (hasNotices) { -%>
  <ul class="sidebar__notices">
    <%- foreach (notice; notices) { -%>
    <li class="sidebar__notice"><%= notice %></li>
    <%- } -%>
  </ul>
  <%- } -%>

  <%- if (hasNavigation) { -%>
  <div class="sidebar__sections">
    <% render(sections); %>
  </div>
  <%- } else { -%>
  <p class="sidebar__empty">No navigation available.</p>
  <%- } -%>

  <%- if (hasContent) { -%>
  <div class="sidebar__extra"><%= content %></div>
  <%- } -%>

  <%- if (hasFooter) { -%>
  <% render(footer); %>
  <%- } -%>
</nav>
