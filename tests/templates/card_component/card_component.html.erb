<div class="card">
  <%- if (hasHeading) { -%>
  <h2 class="card__heading"><%= heading %></h2>
  <%- } -%>
  <div class="card__body"><%= content %></div>
  <%# this comment never reaches the output %>
  <%- if (hasActions) { -%>
  <footer class="card__actions"><% render(actions); %></footer>
  <%- } -%>
</div>
